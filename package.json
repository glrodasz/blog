{
  "name": "undefined-shell",
  "type": "module",
  "version": "0.2.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:locale": "node scripts/build-locale-redirect.mjs",
    "dev": "yarn build:locale && astro dev",
    "start": "yarn build:locale && astro dev",
    "build": "astro check && yarn build:locale && node scripts/generate-og.mjs && astro build && cp _redirects dist/_redirects",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --test scripts/audio/*.test.mjs",
    "audio:generate": "node scripts/audio/generate.mjs",
    "audio:script": "node scripts/audio/print-narration.mjs",
    "audio:audition": "node scripts/audio/audition.mjs",
    "audio:check-alt": "node scripts/audio/check-alt.mjs",
    "audio:describe-images": "node scripts/audio/describe-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "lucide": "0.561.0",
    "lucide-astro": "0.556.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.5",
    "typescript": "^5.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.13.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "packageManager": "yarn@4.10.3"
}
