---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Container from "../../components/Container.astro";
import SimpleAnalytics from "../../components/SimpleAnalytics.astro";
import PostGrid from "../../components/PostGrid.astro";
import SearchBar from "../../components/SearchBar.astro";
import DiscordCallout from "../../components/DiscordCallout.astro";
import BackLink from "../../components/BackLink.astro";
import {
  type Post,
  getPostsByLanguage,
  getPostTags,
  tagToSlug,
} from "../../utils/content";
import { getMessages } from "../../i18n";
import { getLocaleFromAstro } from "../../i18n/config";

export async function getStaticPaths() {
  const posts = await getPostsByLanguage("en");
  const tagMap = new Map<string, { label: string; posts: Post[] }>();

  for (const post of posts) {
    for (const tag of getPostTags(post)) {
      const slug = tagToSlug(tag);
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { label: tag, posts: [] });
      }
      tagMap.get(slug)!.posts.push(post);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, entry]) => ({
    params: { tag: slug },
    props: {
      tagLabel: entry.label,
      posts: entry.posts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      ),
      locale: "en" as const,
    },
  }));
}

type Props = {
  tagLabel: string;
  posts: Post[];
  locale: "en";
};

const { tagLabel, posts } = Astro.props;
const locale = getLocaleFromAstro(Astro);
const messages = getMessages(locale);
const pageTitle = messages.tagPage.title.replace("{tag}", tagLabel);
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead
      title={`${pageTitle} — ${messages.site.title}`}
      description={messages.site.description}
      image={`/og/tags/${tagToSlug(tagLabel)}.png`}
      locale={locale}
    />
  </head>
  <body>
    <Header locale={locale} />
    <main id="main-content" class="tag-page" tabindex="-1">
      <section class="tag-header">
        <Container>
          <BackLink />
          <div class="title-row">
            <h1 class="title">#{tagLabel}</h1>
            <SearchBar
              locale={locale}
              placeholder={messages.filter.searchInPlaceholder.replace(
                "{tag}",
                tagLabel,
              )}
            />
          </div>
        </Container>
      </section>
      <PostGrid posts={posts} locale={locale} layout="grid" />
      <DiscordCallout locale={locale} />
    </main>
    <Footer locale={locale} />
    <SimpleAnalytics />
    <script>
      import { normalizeForSearch } from "../../utils/searchNormalize";

      document.addEventListener("DOMContentLoaded", () => {
        const searchInput = document.querySelector<HTMLInputElement>(
          "[data-search-input]",
        );
        const wrapper = document.querySelector<HTMLElement>("[data-post-grid]");
        const emptyState =
          document.querySelector<HTMLElement>("[data-empty-state]");
        if (!wrapper) return;

        const cards = Array.from(
          wrapper.querySelectorAll<HTMLElement>(".filter-view [data-search]"),
        );

        let query = "";

        const apply = () => {
          let visibleCount = 0;
          cards.forEach((card) => {
            const haystack = card.dataset.search ?? "";
            const show = !query || haystack.includes(query);
            card.style.display = show ? "" : "none";
            if (show) visibleCount += 1;
          });

          if (emptyState) {
            emptyState.hidden = visibleCount > 0;
          }
        };

        let debounceId: number | undefined;
        searchInput?.addEventListener("input", () => {
          if (debounceId) window.clearTimeout(debounceId);
          debounceId = window.setTimeout(() => {
            query = normalizeForSearch(searchInput.value ?? "");
            apply();
          }, 120);
        });

        const mobileQuery = window.matchMedia("(max-width: 640px)");
        searchInput?.addEventListener("focus", () => {
          if (!mobileQuery.matches) return;
          const header = document.getElementById("main-header");
          const offset = (header?.offsetHeight ?? 0) + 16;
          const top =
            searchInput.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: "smooth" });
        });
      });
    </script>
    <style>
      .tag-header {
        padding: 1.5em 0 1em;
      }

      .title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin: 0.4em 0 0.8em;
      }

      .title {
        margin: 0;
        min-width: 0;
        color: var(--color-text-strong);
        font-size: 2.4em;
        line-height: 1.1;
        overflow-wrap: anywhere;
      }

      @media (min-width: 641px) {
        .title-row :global(.search-bar) {
          flex-basis: 280px;
          min-width: 280px;
        }
      }

      @media (max-width: 640px) {
        .title-row {
          flex-direction: column;
          align-items: stretch;
          gap: 0.75em;
        }
      }
    </style>

    <style is:global>
      /* Same expand-on-focus as the home filter bar: the collapsed search
     grows into the free space next to the title. Global because Astro can't
     scope :global() inside :has(). */
      @media (min-width: 641px) {
        .title-row:has([data-search-input]:focus) .search-bar {
          flex: 1 1 auto;
        }
      }
    </style>
  </body>
</html>
