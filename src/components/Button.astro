---
export interface Props {
  href: string;
  title: string;
  type?: "primary" | "secondary" | "outline";
  size?: "sm" | "md" | "lg";
}

const { href, title, type = "primary", size = "md" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`btn btn-${size} btn-${type}`}
>
  <slot />
  <span>{title}</span>
</a>
