---
import { type Locale, getLocaleFromAstro } from "../i18n/config";
import { getMessages } from "../i18n";
import Headphones from "lucide-astro/Headphones";
import Play from "lucide-astro/Play";
import Pause from "lucide-astro/Pause";
import RotateCcw from "lucide-astro/RotateCcw";
import RotateCw from "lucide-astro/RotateCw";
import X from "lucide-astro/X";
import type { PostAudio } from "../utils/audio";
import { toMinutes } from "../utils/audio";

type Props = {
  audio: PostAudio;
  title: string;
  locale?: Locale;
};

const { audio, title } = Astro.props;
const locale = getLocaleFromAstro(Astro);
const messages = getMessages(locale);
const minutes = toMinutes(audio.durationSeconds);
const id = `audio-${Math.random().toString(36).slice(2, 8)}`;

const formatTime = (seconds: number) => {
  const s = Math.floor(seconds);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
};
---

<button
  type="button"
  class="audio-trigger"
  aria-expanded="false"
  aria-controls={id}
  aria-label={`${messages.blog.listenLabel} (${minutes} ${messages.blog.minReadCard})`}
>
  <Headphones size={14} aria-hidden="true" />
  <span class="audio-trigger-label">{messages.blog.listen}</span>
  <span class="audio-trigger-duration"
    >· {minutes} {messages.blog.minReadCard}</span
  >
</button>

<div
  class="audio-bar"
  id={id}
  role="region"
  aria-label={messages.blog.listenLabel}
  data-open="false"
  data-playing="false"
  data-title={title}
  data-artist={messages.site.author}
  data-play-label={messages.blog.audioPlay}
  data-pause-label={messages.blog.audioPause}
>
  <audio preload="none" src={audio.src}></audio>
  <button
    type="button"
    class="audio-bar-play"
    aria-label={messages.blog.audioPlay}
  >
    <Play size={18} aria-hidden="true" class="icon-play" />
    <Pause size={18} aria-hidden="true" class="icon-pause" />
  </button>
  <button
    type="button"
    class="audio-bar-icon audio-bar-skip"
    data-skip="-15"
    aria-label={messages.blog.audioBack}
  >
    <RotateCcw size={16} aria-hidden="true" />
  </button>
  <div class="audio-bar-main">
    <span class="audio-bar-title">{title}</span>
    <div class="audio-bar-progress">
      <input
        type="range"
        class="audio-bar-seek"
        min="0"
        max={Math.round(audio.durationSeconds)}
        step="1"
        value="0"
        aria-label={messages.blog.audioSeek}
      />
      <span class="audio-bar-time" aria-hidden="true">
        <span class="audio-bar-current">0:00</span> / <span
          class="audio-bar-duration">{formatTime(audio.durationSeconds)}</span
        >
      </span>
    </div>
  </div>
  <button
    type="button"
    class="audio-bar-icon audio-bar-skip"
    data-skip="15"
    aria-label={messages.blog.audioForward}
  >
    <RotateCw size={16} aria-hidden="true" />
  </button>
  <button
    type="button"
    class="audio-bar-speed"
    aria-label={messages.blog.audioSpeed}
  >
    1×
  </button>
  <button
    type="button"
    class="audio-bar-icon audio-bar-close"
    aria-label={messages.blog.audioClose}
  >
    <X size={16} aria-hidden="true" />
  </button>
</div>

<script>
  const SPEEDS = [1, 1.25, 1.5, 2];

  const formatTime = (seconds: number) => {
    const s = Math.max(0, Math.floor(seconds));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
  };

  document
    .querySelectorAll<HTMLButtonElement>(".audio-trigger")
    .forEach((trigger) => {
      const bar = document.getElementById(
        trigger.getAttribute("aria-controls") ?? "",
      );
      const audio = bar?.querySelector("audio");
      if (!bar || !audio) return;

      const q = <T extends Element>(selector: string) =>
        bar.querySelector<T>(selector)!;
      const playBtn = q<HTMLButtonElement>(".audio-bar-play");
      const speedBtn = q<HTMLButtonElement>(".audio-bar-speed");
      const closeBtn = q<HTMLButtonElement>(".audio-bar-close");
      const seek = q<HTMLInputElement>(".audio-bar-seek");
      const current = q<HTMLElement>(".audio-bar-current");
      const duration = q<HTMLElement>(".audio-bar-duration");
      let seeking = false;

      const setOpen = (open: boolean) => {
        bar.dataset.open = String(open);
        trigger.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("audio-bar-open", open);
      };

      const play = () =>
        audio.play().catch(() => {
          /* autoplay blocked: the play button still works */
        });

      const setProgress = () => {
        seek.style.setProperty(
          "--progress",
          `${(Number(seek.value) / Number(seek.max || 1)) * 100}%`,
        );
      };

      trigger.addEventListener("click", () => {
        if (bar.dataset.open !== "true") {
          setOpen(true);
          play();
        } else if (audio.paused) {
          play();
        } else {
          audio.pause();
        }
      });

      playBtn.addEventListener("click", () =>
        audio.paused ? play() : audio.pause(),
      );

      bar
        .querySelectorAll<HTMLButtonElement>(".audio-bar-skip")
        .forEach((button) =>
          button.addEventListener("click", () => {
            audio.currentTime = Math.min(
              Math.max(0, audio.currentTime + Number(button.dataset.skip)),
              audio.duration || Infinity,
            );
          }),
        );

      speedBtn.addEventListener("click", () => {
        const next =
          SPEEDS[(SPEEDS.indexOf(audio.playbackRate) + 1) % SPEEDS.length] ?? 1;
        audio.playbackRate = next;
        speedBtn.textContent = `${next}×`;
      });

      closeBtn.addEventListener("click", () => {
        audio.pause();
        setOpen(false);
        trigger.focus();
      });

      seek.addEventListener("input", () => {
        seeking = true;
        current.textContent = formatTime(Number(seek.value));
        setProgress();
      });
      seek.addEventListener("change", () => {
        audio.currentTime = Number(seek.value);
        seeking = false;
      });

      audio.addEventListener("loadedmetadata", () => {
        seek.max = String(Math.round(audio.duration));
        duration.textContent = formatTime(audio.duration);
        setProgress();
      });

      audio.addEventListener("timeupdate", () => {
        if (seeking) return;
        seek.value = String(Math.floor(audio.currentTime));
        current.textContent = formatTime(audio.currentTime);
        setProgress();
      });

      const syncPlaying = () => {
        const playing = !audio.paused;
        bar.dataset.playing = String(playing);
        trigger.dataset.playing = String(playing);
        playBtn.setAttribute(
          "aria-label",
          (playing ? bar.dataset.pauseLabel : bar.dataset.playLabel) ?? "",
        );
      };
      audio.addEventListener("play", syncPlaying);
      audio.addEventListener("pause", syncPlaying);
      audio.addEventListener("ended", syncPlaying);

      // Lock screen / headset controls.
      if ("mediaSession" in navigator) {
        audio.addEventListener("play", () => {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: bar.dataset.title,
            artist: bar.dataset.artist,
          });
        });
        navigator.mediaSession.setActionHandler("seekbackward", () => {
          audio.currentTime = Math.max(0, audio.currentTime - 15);
        });
        navigator.mediaSession.setActionHandler("seekforward", () => {
          audio.currentTime += 15;
        });
      }
    });
</script>

<style>
  .audio-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.2em 0.7em;
    background: var(--color-bg-inset);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-chip);
    color: inherit;
    font-size: 0.9em;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .audio-trigger:hover,
  .audio-trigger[aria-expanded="true"] {
    color: var(--color-accent-hover);
    border-color: var(--color-accent-emphasis);
  }

  .audio-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .audio-trigger-duration {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  /* Floating player pinned to the bottom of the viewport. */
  .audio-bar {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 50;
    width: min(640px, calc(100% - 24px));
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.6em 0.75em;
    background: var(--color-bg-surface);
    color: var(--color-text-default);
    border: 1px solid var(--color-border-default);
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(var(--gray), 25%);
    font-size: 16px;
    transform: translate(-50%, calc(100% + 24px));
    visibility: hidden;
    transition:
      transform 0.25s ease,
      visibility 0s linear 0.25s;
  }

  .audio-bar[data-open="true"] {
    transform: translate(-50%, 0);
    visibility: visible;
    transition: transform 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .audio-bar,
    .audio-bar[data-open="true"] {
      transition: none;
    }
  }

  .audio-bar button {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    cursor: pointer;
    font: inherit;
  }

  .audio-bar button:focus-visible,
  .audio-bar-seek:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .audio-bar-play {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-accent-emphasis);
    color: var(--color-white);
  }

  .audio-bar-play:hover {
    background: var(--color-accent-hover);
  }

  .audio-bar :global(.icon-pause),
  .audio-bar[data-playing="true"] :global(.icon-play) {
    display: none;
  }

  .audio-bar[data-playing="true"] :global(.icon-pause) {
    display: block;
  }

  .audio-bar-icon,
  .audio-bar-speed {
    height: 32px;
    min-width: 32px;
    border-radius: var(--radius-chip);
    background: transparent;
    color: var(--color-text-muted);
  }

  .audio-bar-speed {
    padding: 0 0.4em;
    font-size: 0.8em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .audio-bar-icon:hover,
  .audio-bar-speed:hover {
    background: var(--color-bg-inset);
    color: var(--color-accent-hover);
  }

  .audio-bar-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }

  .audio-bar-title {
    font-size: 0.8em;
    font-weight: 700;
    color: var(--color-text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .audio-bar-progress {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .audio-bar-seek {
    --progress: 0%;
    flex: 1;
    min-width: 0;
    height: 4px;
    margin: 0;
    appearance: none;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--color-accent-emphasis) var(--progress),
      var(--color-border-default) var(--progress)
    );
    cursor: pointer;
  }

  .audio-bar-seek::-webkit-slider-thumb {
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent-emphasis);
  }

  .audio-bar-seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent-emphasis);
  }

  .audio-bar-time {
    font-size: 0.7em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Keep the end of the page reachable above the floating bar. */
  :global(body.audio-bar-open) {
    padding-bottom: 96px;
  }

  @media (max-width: 480px) {
    .audio-trigger {
      padding: 0.35em 0.5em;
    }

    .audio-trigger-label {
      display: none;
    }

    .audio-bar {
      gap: 0.25em;
      padding: 0.5em 0.6em;
    }

    .audio-bar .audio-bar-skip {
      display: none;
    }
  }
</style>
