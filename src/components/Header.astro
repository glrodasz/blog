---
import Container from "./Container.astro";
import NavigationLink from "./NavigationLink.astro";
import BootcampButton from "./BootcampButton.astro";
import DiscordButton from "./DiscordButton.astro";
import {
  type Locale,
  getLocaleFromAstro,
  DEFAULT_LOCALE,
} from "../i18n/config";
import { getMessages } from "../i18n";

type Props = {
  locale?: Locale;
};

const locale = getLocaleFromAstro(Astro);
const messages = getMessages(locale);
const homeHref = locale === DEFAULT_LOCALE ? "/" : `/${locale}/`;
---

<a href="#main-content" class="skip-link">{messages.navigation.skipToMain}</a>
<header id="main-header">
  <Container>
    <nav>
      <a href={homeHref} class="brand">
        <img
          src="/favicon.svg"
          alt=""
          width="40"
          height="40"
          class="brand-mark"
          aria-hidden="true"
        />
        <span class="brand-text">
          <span class="brand-title">
            <strong>Undefined</strong>Shell
          </span>
          <span class="brand-tag">{messages.site.shortDescription}</span>
        </span>
      </a>
      <div class="navigation">
        <div class="internal-links">
          <NavigationLink href="/" locale={locale}
            >{messages.navigation.home}</NavigationLink
          >
          <NavigationLink href="/about" locale={locale}
            >{messages.navigation.about}</NavigationLink
          >
        </div>
        <div class="buttons-container">
          <BootcampButton />
          <DiscordButton />
        </div>
      </div>
    </nav>
  </Container>
</header>

<style>
  .skip-link {
    position: absolute;
    top: -9999px;
    left: 0;
    z-index: 9999;
    padding: 0.75em 1.25em;
    background: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
    font-weight: 700;
    text-decoration: none;
    border-radius: 0 0 4px 0;
  }

  .skip-link:focus {
    top: 0;
  }

  header {
    margin: 0;
    width: 100%;
    position: fixed;
    padding: 0;
    background: var(--color-header-bg);
    border-bottom: 1px solid var(--color-border-default);
    box-shadow: none;
    backdrop-filter: none;
    z-index: 10;
  }

  header.scrolled {
    background: linear-gradient(
      to bottom,
      var(--color-header-bg) 0%,
      var(--color-header-bg) 20%,
      var(--color-header-bg-scrolled-fade) 100%
    );
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    backdrop-filter: blur(10px);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6em 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text-strong);
  }

  .brand-mark {
    display: block;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }

  .brand-title {
    white-space: nowrap;
    font-family: var(--font-title);
    font-size: 22px;
    letter-spacing: 0.03em;
  }

  .brand-title strong {
    font-weight: 700;
  }

  .brand-tag {
    margin-top: 0;
    font-size: 11px;
    color: var(--color-aquarius-600);
    letter-spacing: 0.12em;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 1.5em;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.8em;
  }

  .buttons-container {
    display: flex;
    align-items: center;
    gap: 0.8em;
  }

  @media (max-width: 1200px) {
    .buttons-container {
      display: none;
    }

    .brand-tag {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .internal-links > a {
      display: none;
    }

    .brand-title {
      font-size: 14px;
    }
  }
</style>

<script>
  const BRAND_TAG_BASE_PX = 11;
  const BRAND_TAG_MAX_PX = 14;

  // Horizontal ink insets of a glyph: the gap between its advance box and
  // the painted pixels, so edges line up on what is visible, not on boxes.
  function inkInsets(el: Element, ch: string) {
    const cs = getComputedStyle(el);
    const ctx = document.createElement("canvas").getContext("2d");
    if (!ctx) return { left: 0, right: 0 };
    ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    const m = ctx.measureText(ch);
    return {
      left: -m.actualBoundingBoxLeft,
      right: m.width - m.actualBoundingBoxRight,
    };
  }

  function textEdges(el: Element) {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const parts: { node: Element; text: string }[] = [];
    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
      const text = n.textContent?.trim();
      if (text && n.parentElement) parts.push({ node: n.parentElement, text });
    }
    const first = parts[0];
    const last = parts.at(-1);
    const lower = (n: Element, t: string) =>
      getComputedStyle(n).textTransform === "lowercase" ? t.toLowerCase() : t;
    return {
      first: first?.node ?? el,
      last: last?.node ?? el,
      firstChar: first ? lower(first.node, Array.from(first.text)[0]) : "",
      lastChar: last
        ? lower(last.node, Array.from(last.text).at(-1) ?? "")
        : "",
      chars: Array.from((el.textContent ?? "").trim()).length,
    };
  }

  // Visible (ink) width and left ink offset of a single-line text element.
  function inkBox(el: HTMLElement) {
    const e = textEdges(el);
    const trailing = parseFloat(getComputedStyle(e.last).letterSpacing) || 0;
    const left = inkInsets(e.first, e.firstChar).left;
    const right = inkInsets(e.last, e.lastChar).right;
    return {
      left,
      width: el.scrollWidth - trailing - left - right,
      chars: e.chars,
    };
  }

  // Match the tagline's painted width to the brand title's: shrink the font
  // when the tagline is longer, otherwise grow it up to a cap and fill the
  // rest with letter-spacing so short taglines don't render oversized.
  function fitBrandTag() {
    const brand = document.querySelector(".brand .brand-text");
    const title = brand?.querySelector(".brand-title");
    const tag = brand?.querySelector(".brand-tag");
    if (!(title instanceof HTMLElement) || !(tag instanceof HTMLElement))
      return;
    tag.style.removeProperty("font-size");
    tag.style.removeProperty("letter-spacing");
    tag.style.removeProperty("margin-left");
    tag.style.removeProperty("margin-right");
    if (getComputedStyle(tag).display === "none") return;
    const target = inkBox(title);
    if (target.width < 1) return;
    tag.style.fontSize = `${BRAND_TAG_BASE_PX}px`;
    const base = inkBox(tag);
    if (base.width < 0.1) return;
    const size = Math.min(
      (BRAND_TAG_BASE_PX * target.width) / base.width,
      BRAND_TAG_MAX_PX,
    );
    tag.style.fontSize = `${size}px`;
    const sized = inkBox(tag);
    tag.style.marginLeft = `${target.left - sized.left}px`;
    if (sized.chars < 2 || sized.width >= target.width - 0.25) return;
    const baseSpacing = parseFloat(getComputedStyle(tag).letterSpacing) || 0;
    const spacing =
      baseSpacing + (target.width - sized.width) / (sized.chars - 1);
    tag.style.letterSpacing = `${spacing}px`;
    tag.style.marginRight = `${-spacing}px`;
  }

  function handleScroll() {
    const header = document.getElementById("main-header");
    if (!header) return;
    if (window.scrollY > 0) {
      header.classList.add("scrolled");
    } else {
      header.classList.remove("scrolled");
    }
  }

  function setupBrandTagFit() {
    const run = () => {
      requestAnimationFrame(() => {
        void document.fonts.ready.then(() => {
          requestAnimationFrame(fitBrandTag);
        });
      });
    };
    const header = document.getElementById("main-header");
    if (header) {
      const ro = new ResizeObserver(run);
      ro.observe(header);
    }
    const mq = window.matchMedia("(min-width: 1201px)");
    mq.addEventListener("change", run);
    run();
  }

  document.addEventListener("DOMContentLoaded", () => {
    window.addEventListener("scroll", handleScroll);
    handleScroll();
    setupBrandTagFit();
  });
  window.addEventListener("load", () => {
    void document.fonts.ready.then(() => {
      requestAnimationFrame(fitBrandTag);
    });
  });
</script>
