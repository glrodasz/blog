---
export interface Props {
  slug: string;
  user: string;
  title?: string;
  tabs?: string;
  height?: string | number;
}

const { slug, user, title, tabs = "html,result", height = 400 } = Astro.props;

const penUrl = `https://codepen.io/${user}/pen/${slug}`;
const userUrl = `https://codepen.io/${user}`;
const embedUrl = `https://codepen.io/${user}/embed/${slug}?default-tab=${encodeURIComponent(tabs)}`;
const linkText = title ?? "this Pen";
---

<figure class="codepen-embed">
  <iframe
    src={embedUrl}
    height={height}
    title={`CodePen: ${title ?? slug}`}
    loading="lazy"
    allowfullscreen></iframe>
  <figcaption>
    See <a href={penUrl}>{linkText}</a> by <a href={userUrl}>@{user}</a> on <a
      href="https://codepen.io">CodePen</a
    >.
  </figcaption>
</figure>

<style>
  .codepen-embed {
    margin: 0 0 2em;
  }

  .codepen-embed iframe {
    display: block;
    width: 100%;
    border: 0;
  }

  .codepen-embed figcaption {
    margin-top: 0.5em;
    font-size: 0.875em;
    color: var(--color-text-muted);
  }
</style>
