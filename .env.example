# Azure Speech (S0 resource). Used by scripts/audio/generate.mjs and audition.mjs.
# In CI these are GitHub Actions secrets with the same names.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# Azure OpenAI vision deployment. Only for scripts/audio/describe-images.mjs (run locally).
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
