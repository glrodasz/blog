# Netlify response headers. Copied verbatim from public/ into dist/ by Astro.
#
# Rules: security headers live only on /*; Cache-Control lives only on
# specific asset paths (never on /*) because Netlify comma-joins a header
# defined by several matching rules. HTML, /og/*, /locale-redirect.js,
# site.webmanifest, robots.txt, RSS and sitemaps keep Netlify's default
# (max-age=0, must-revalidate) on purpose: they are unhashed and change
# between builds.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://scripts.simpleanalyticscdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://queue.simpleanalyticscdn.com; connect-src 'self' https://queue.simpleanalyticscdn.com; frame-src https://codepen.io; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build output: safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed content assets: 30 days in browsers, 1 day at CDN edges
/covers/*
  Cache-Control: public, max-age=2592000, s-maxage=86400
/images/*
  Cache-Control: public, max-age=2592000, s-maxage=86400
/authors/*
  Cache-Control: public, max-age=2592000, s-maxage=86400
/icons/*
  Cache-Control: public, max-age=2592000, s-maxage=86400
/favicon.ico
  Cache-Control: public, max-age=2592000, s-maxage=86400
/favicon.svg
  Cache-Control: public, max-age=2592000, s-maxage=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, s-maxage=86400
/android-chrome-192x192.png
  Cache-Control: public, max-age=2592000, s-maxage=86400
/android-chrome-512x512.png
  Cache-Control: public, max-age=2592000, s-maxage=86400
